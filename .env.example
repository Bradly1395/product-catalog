# -----------------------------------------------------------------------------
# Storefront Branding (Optional)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STORE_NAME="Atelier Foundry"
NEXT_PUBLIC_STORE_TAGLINE="Architectural hardware, studio lighting, and modular objects."

# -----------------------------------------------------------------------------
# Admin Authentication (Required)
# -----------------------------------------------------------------------------
# Password required to sign in at /login and manage products at /admin
ADMIN_PASSWORD="change-this-strong-password"

# Secret used by jose to sign HTTP-only admin session cookies (min 32 chars recommended)
# Generate one with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-random-32-plus-character-secret-key"

# -----------------------------------------------------------------------------
# Local SQLite Database (Optional)
# -----------------------------------------------------------------------------
# Defaults to ./data/catalog.db relative to project root
DATABASE_PATH="./data/catalog.db"

# -----------------------------------------------------------------------------
# Inquiry Email Delivery via Nodemailer / Standard SMTP (Required for inquiries)
# -----------------------------------------------------------------------------
# Destination inbox that receives customer product inquiries
ADMIN_EMAIL="owner@example.com"

# Standard SMTP server credentials (works with any SMTP provider or local mail relay)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
# Set to "true" for implicit TLS (port 465), "false" for STARTTLS (port 587)
SMTP_SECURE="false"
SMTP_USER="smtp-username@example.com"
SMTP_PASS="smtp-password"
# Optional From header (defaults to SMTP_USER if omitted)
SMTP_FROM="Atelier Foundry Catalog <no-reply@example.com>"
